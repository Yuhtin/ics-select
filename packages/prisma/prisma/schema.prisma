generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// Placeholder so `prisma generate` succeeds in Phase 0.
// Prisma 5 refuses to generate a client with zero models.
// This model is intentionally not part of any migration and
// will be replaced by real domain models in Phase 1.
model Phase0Marker {
  id Int @id @default(autoincrement())
}
