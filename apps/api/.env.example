# ================================================================
# ICS Select — API environment variables
# ----------------------------------------------------------------
# Copy this file to `.env` (local dev) or paste each value into
# EasyPanel (prod). All "required" vars must be set or the API
# will refuse to boot.
# ================================================================


# ─── Runtime ────────────────────────────────────────────────────
# Not required; defaults shown.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
# LOG_LEVEL options: fatal | error | warn | info | debug | trace


# ─── Database (required) ────────────────────────────────────────
# Postgres connection string. In prod on EasyPanel, the Postgres
# service gives you an internal DNS — use it here. The `?schema=public`
# suffix is required.
#
# Local dev (docker compose up -d postgres):
# DATABASE_URL=postgresql://ics:ics_dev_password@localhost:5432/ics_select?schema=public
#
# Prod example (EasyPanel internal DNS):
# DATABASE_URL=postgresql://USER:PASSWORD@ics-select_postgres:5432/ics_select?schema=public

DATABASE_URL=


# ─── CORS (required) ────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to hit the API.
# Must match exactly (scheme + host + port, no trailing slash).
#
# Local: CORS_ALLOWED_ORIGINS=http://localhost:3000
# Prod:  CORS_ALLOWED_ORIGINS=https://ics.daviduarte.com.br
#
# Multiple (comma, no spaces):
# CORS_ALLOWED_ORIGINS=https://ics.daviduarte.com.br,https://ics-select.vercel.app

CORS_ALLOWED_ORIGINS=


# ─── Auth — JWT (required) ──────────────────────────────────────
# Secret used to sign access JWTs. Must be at least 32 characters.
# Generate with:  openssl rand -base64 48

JWT_SECRET=


# ─── Auth — Encryption key (required) ───────────────────────────
# 32 bytes in base64. Used to AES-256-GCM encrypt the Google Calendar
# access/refresh tokens stored in GoogleAccount.
# Generate with:  openssl rand -base64 32

ENCRYPTION_KEY=


# ─── Auth — Google OAuth (required) ─────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials.
# Create an "OAuth client ID" of type "Web application".
#
# Authorized JavaScript origins (add both):
#   http://localhost:3000
#   https://ics.daviduarte.com.br
#
# Authorized redirect URIs (add both):
#   http://localhost:3001/auth/google/callback
#   https://ics-api.daviduarte.com.br/auth/google/callback
#
# Enable these APIs on the same project:
#   - Google Calendar API
#   - Google People API

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://ics-api.daviduarte.com.br/auth/google/callback


# ─── Auth — Inteli domain allowlist (required) ──────────────────
# Comma-separated list of email domains allowed to log in (no `@`).
# At least one value is mandatory.
#
# Prod:
# ALLOWED_EMAIL_DOMAINS=sou.inteli.edu.br
#
# Dev (to let your personal Google account log in as admin too):
# ALLOWED_EMAIL_DOMAINS=sou.inteli.edu.br,gmail.com

ALLOWED_EMAIL_DOMAINS=sou.inteli.edu.br


# ─── Auth — Bootstrap admins (optional) ─────────────────────────
# Comma-separated list of emails that are automatically promoted to
# ADMIN on their first login. Use this to seed the first admin; once
# the real admin exists, you can leave it empty.

BOOTSTRAP_ADMIN_EMAILS=


# ─── Frontend URL (required) ────────────────────────────────────
# Used to build the post-login redirect. Must match the Vercel
# deployment URL or your custom domain.
#
# Local: FRONTEND_BASE_URL=http://localhost:3000
# Prod:  FRONTEND_BASE_URL=https://ics.daviduarte.com.br

FRONTEND_BASE_URL=https://ics.daviduarte.com.br


# ─── OpenAI (required) ──────────────────────────────────────────
# Single key used for BOTH embeddings (library search) and chat
# completions (gpt-5.4-mini for draft/brief/diagnose/chat features).
# Get one at platform.openai.com → API keys.

OPENAI_API_KEY=


# ─── WhatsApp via Evolution API (optional, Phase 7) ─────────────
# All four are optional. If any is missing, the feature degrades
# gracefully — the scheduler writes an error to WhatsappLog and
# skips the send.
#
# To enable:
# 1. `docker compose --profile whatsapp up -d evolution` locally,
#    or run the Evolution API service on EasyPanel.
# 2. Pair your WhatsApp number via QR code in the Evolution admin.
# 3. Fill in the values below.
#
# ADMIN_WHATSAPP_NUMBER format: E.164 without `+` or `-`
#   (e.g. 5511999999999 for a Brazilian São Paulo number)

EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ADMIN_WHATSAPP_NUMBER=
